NEXT_PUBLIC_SITE_URL=https://www.groupelaporte.ca

# Clé API Resend (resend.com) — requise pour que le formulaire de contact
# envoie réellement un courriel. Sans elle, le formulaire retourne une erreur
# plutôt que d'échouer silencieusement.
RESEND_API_KEY=

# Optionnel — adresse d'expédition. Doit appartenir à un domaine vérifié
# dans Resend (sinon Resend refuse l'envoi). En attendant la vérification
# du domaine groupelaporte.ca, "onboarding@resend.dev" fonctionne mais ne
# peut envoyer qu'à l'adresse du compte Resend lui-même.
CONTACT_FROM_EMAIL="Site Groupe Laporte <onboarding@resend.dev>"

# Optionnel — adresse qui reçoit les soumissions du formulaire.
CONTACT_TO_EMAIL=jlaporte@groupelaporte.ca
